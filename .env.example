
# Site URL
NEXT_PUBLIC_SITE_URL="https://raihanmd.xyz"

# SEO Verification (optional - get from Google Search Console / Yandex Webmaster)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-verification-code"
NEXT_PUBLIC_YANDEX_VERIFICATION="your-yandex-verification-code"

# Payload CMS
DATABASE_URL="postgres://user:password@localhost:5432/portfolio-v2"
PAYLOAD_SECRET="generate-a-long-random-secret"

# Supabase Storage S3 (server-only). One public bucket stores both Project Media
# under projects/ and Blog Images under blogs/. No second bucket is needed.
# All six values are required before media uploads are enabled.
# The endpoint and region are shown under Storage > S3 Configuration.
SUPABASE_S3_ENDPOINT=""
SUPABASE_S3_REGION=""
SUPABASE_S3_BUCKET=""
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
# Public bucket base URL, e.g. https://PROJECT_REF.supabase.co/storage/v1/object/public/BUCKET
SUPABASE_STORAGE_PUBLIC_URL=""
